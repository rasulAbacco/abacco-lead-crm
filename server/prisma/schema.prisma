// Abacco Lead CRM — v2 schema
// Removed in v2: Sales CRM forwarding, sales employees, share links, quotes,
// email domains, deal updates, push notifications, legacy industry table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum LoginStatus {
  SUCCESS
  FAILED
}

/// Status an admin gives to a lead. New leads start as PENDING.
enum LeadStatus {
  PENDING
  ACTIVE
  NO_RESPONSE
  LEAVE_OUT
}

/// Lifecycle of a monthly data-retention run.
enum RetentionStatus {
  PENDING // month expired, report not yet emailed
  NOTIFIED // report emailed + 48h notice running
  DELETED // leads of that month permanently deleted
}

model Lead {
  id              Int        @id @default(autoincrement())
  employeeId      String
  agentName       String?
  clientEmail     String
  leadEmail       String
  ccEmail         String?
  subjectLine     String
  emailPitch      String
  emailResponce   String?
  website         String?
  phone           String?
  country         String?
  leadType        String
  link            String
  attendeesCount  Int?
  date            DateTime // contact date chosen on the upload form
  createdAt       DateTime   @default(now()) // upload date: used for retention + duplicates
  isEdited        Boolean?   @default(false)
  status          LeadStatus @default(PENDING)
  statusUpdatedAt DateTime?

  employee Employee @relation(fields: [employeeId], references: [employeeId])

  @@index([employeeId, date])
  @@index([date])
  @@index([createdAt])
  @@index([clientEmail, createdAt])
  @@index([status])
}

model Employee {
  id          Int       @id @default(autoincrement())
  employeeId  String    @unique
  fullName    String
  email       String    @unique
  password    String // bcrypt hash
  role        String    @default("EMPLOYEE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  target      Int       @default(0)
  joiningDate DateTime
  isActive    Boolean   @default(true)

  leads             Lead[]
  sessions          Session[]
  loginHistory      LoginHistory[]
  leadTarget        EmployeeLeadTarget?
  leadingTeams      Team[]                 @relation("EmployeeLeadingTeams")
  teamMemberships   TeamMember[]           @relation("EmployeeTeamMemberships")
  teamReports       TeamMonthlyReport[]    @relation("EmployeeTeamReports")
  dealAnnouncements TeamDealAnnouncement[]

  /// Which Saturdays this person works (attendance report)
  saturdayRule      SaturdayRule           @default(ALTERNATE)
  workSessions      WorkSession[]
  biometricMappings BiometricMapping[]
  punches           BiometricPunch[]
  notifications     Notification[]
  workDayOverrides  WorkDayOverride[]

  @@index([role])
  @@index([isActive])
}

model EmployeeLeadTarget {
  id Int @id @default(autoincrement())

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  associationPercent     Int @default(0)
  attendeesPercent       Int @default(0)
  industryPercent        Int @default(0)
  memberAttendeesPercent Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncentivePlan {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  icon        String
  accentColor String
  bgAccent    String

  isActive  Boolean   @default(true)
  validFrom DateTime  @default(now())
  validTo   DateTime?

  rules IncentiveRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncentiveRule {
  id Int @id @default(autoincrement())

  leadType          String
  country           String?
  attendeesMinCount Int?
  industryDomain    String?

  leadsRequired Int
  amount        Int

  isActive Boolean @default(true)

  incentivePlanId Int
  incentivePlan   IncentivePlan @relation(fields: [incentivePlanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model LoginOtp {
  id Int @id @default(autoincrement())

  email String @unique
  otp   String

  attempts Int @default(0)

  expiresAt         DateTime
  resendAvailableAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Session {
  id        Int      @id @default(autoincrement())
  sessionId String?
  userId    Int
  user      Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique

  ipAddress String?
  device    String?

  loginTime  DateTime @default(now())
  lastActive DateTime @default(now())

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
}

/// Kept for 7 days only (cleaned automatically).
model LoginHistory {
  id String @id @default(uuid())

  userId Int?
  user   Employee? @relation(fields: [userId], references: [id], onDelete: Cascade)

  employeeId   String
  employeeName String
  email        String

  ipAddress String?
  isp       String?
  location  String?

  latitude  Float?
  longitude Float?

  browser        String?
  browserVersion String?
  os             String?
  deviceType     String?
  deviceId       String?

  sessionId String?

  loginTime  DateTime  @default(now())
  logoutTime DateTime?

  sessionDuration Int?

  status LoginStatus

  otpVerified Boolean @default(false)
  loginMethod String?

  attemptCount   Int     @default(1)
  suspiciousFlag Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([loginTime])
  @@index([sessionId])
}

model AllowedIP {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  label     String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([status])
}

model Team {
  id Int @id @default(autoincrement())

  name        String
  description String?
  leaderId    String
  targetValue Float   @default(0)

  leader Employee @relation("EmployeeLeadingTeams", fields: [leaderId], references: [employeeId])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members TeamMember[]
  reports TeamMonthlyReport[]

  @@index([leaderId])
  @@index([isActive])
}

model TeamMember {
  id Int @id @default(autoincrement())

  teamId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation("EmployeeTeamMemberships", fields: [employeeId], references: [employeeId])

  createdAt DateTime @default(now())

  @@unique([teamId, employeeId])
  @@index([employeeId])
}

model TeamMonthlyReport {
  id Int @id @default(autoincrement())

  teamId Int
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation("EmployeeTeamReports", fields: [employeeId], references: [employeeId])

  month Int
  year  Int

  deal            Int    @default(0)
  invoicePending  Int    @default(0)
  invoiceCancel   Int    @default(0)
  activeClients   Int    @default(0)
  leaveOutClients Int    @default(0)
  noResponse      Int    @default(0)
  totalLeads      Int    @default(0)
  dealValue       Float? @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, employeeId, month, year])
  @@index([teamId])
  @@index([month, year])
}

model TeamDealAnnouncement {
  id Int @id @default(autoincrement())

  employeeId String
  month      Int
  year       Int
  amount     Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([month, year])
}

/// One row per calendar month that has expired (4-month retention).
model RetentionRun {
  id    Int @id @default(autoincrement())
  year  Int
  month Int // 1-12

  rangeStart DateTime // start of month, US Central, stored as UTC
  rangeEnd   DateTime // start of next month

  leadCount Int             @default(0)
  status    RetentionStatus @default(PENDING)

  emailedAt    DateTime?
  emailError   String?
  deleteAfter  DateTime?
  deletedAt    DateTime?
  deletedCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@index([status])
}

/// Small key/value store (e.g. release date for the "What's new" popup).
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// WORKING = every Saturday is a working day, OFF = Saturdays off,
/// ALTERNATE = 1st/3rd/5th Saturday working, 2nd + 4th off.
enum SaturdayRule {
  WORKING
  OFF
  ALTERNATE
}

/// System clock-in / clock-out (independent of website login/logout).
/// Kept for 2 months.
model WorkSession {
  id         Int       @id @default(autoincrement())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  workDate   String // yyyy-MM-dd, US Central date of the clock-in
  clockIn    DateTime
  clockOut   DateTime?
  /// true when nobody clocked out and the system closed it at 4:30 AM IST
  autoClosed Boolean   @default(false)
  clockInIp  String?
  clockOutIp String?
  createdAt  DateTime  @default(now())

  @@index([employeeId, workDate])
  @@index([clockOut])
  @@index([workDate])
}

/// Biometric machine registered in the CRM (punches from unknown machines are ignored).
model BiometricDevice {
  id         Int      @id @default(autoincrement())
  deviceCode String
  serialNo   String
  deviceName String?
  location   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  punches BiometricPunch[]

  @@unique([deviceCode, location])
}

/// Card / enrollment ID on the machine -> employee.
model BiometricMapping {
  id            Int       @id @default(autoincrement())
  enrollmentId  String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  location      String
  isActive      Boolean   @default(true)
  assignedAt    DateTime  @default(now())
  deactivatedAt DateTime?

  punches BiometricPunch[]

  @@index([enrollmentId, location, isActive])
  @@index([employeeId])
}

/// Raw punch from a biometric machine. Kept for 2 months.
model BiometricPunch {
  id           Int               @id @default(autoincrement())
  enrollmentId String
  deviceId     Int?
  device       BiometricDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  mappingId    Int?
  mapping      BiometricMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  employeeId   String?
  employee     Employee?         @relation(fields: [employeeId], references: [employeeId], onDelete: SetNull)
  location     String?
  punchTime    DateTime
  punchMode    String?
  createdAt    DateTime          @default(now())

  @@index([employeeId, punchTime])
  @@index([punchTime])
  @@index([enrollmentId, punchTime])
}

/// In-app notifications (bell). Kept 30 days.
model Notification {
  id         Int       @id @default(autoincrement())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  type       String // lead_status | retention | attendance | clock | incentive | system
  title      String
  body       String?
  link       String?
  refKey     String? // used to update instead of duplicate (e.g. one per lead)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId, readAt])
  @@index([employeeId, refKey])
  @@index([createdAt])
}
/* ---------------- Working-day calendar ---------------- */

enum WorkDayType {
  WORKING
  HOLIDAY
  WEEK_OFF
}

/// Company calendar: a date that is different for EVERYONE
/// (e.g. a normally-off Saturday made a working day, or a festival holiday).
/// Dates without a row follow the normal rules (Sunday off, Saturdays per person).
model WorkCalendarDay {
  date      String      @id // yyyy-MM-dd, US Central date
  type      WorkDayType
  note      String?
  updatedAt DateTime    @updatedAt
}

/// One person's exception for one date, e.g. "must work this Saturday"
/// (behind target) or "off this day". Beats the company calendar.
model WorkDayOverride {
  id         Int      @id @default(autoincrement())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  date       String // yyyy-MM-dd, US Central date
  working    Boolean
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

/// Which Saturdays are off in a month for people on the ALTERNATE Saturday rule.
/// No row = 2nd + 4th Saturday off.
model WorkMonthRule {
  month        String   @id // yyyy-MM
  saturdaysOff String // e.g. "2,4" or "1,3,5" ("" = all Saturdays working)
  updatedAt    DateTime @updatedAt
}

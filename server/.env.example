# ---- required ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"
JWT_SECRET="long-random-string"

# SMTP (OTP login emails + monthly retention reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@abaccotech.com
SMTP_PASS=app-password
EMAIL_FROM="Abacco Lead CRM <noreply@abaccotech.com>"

# ---- optional (defaults shown) ----
# CORS_ORIGINS=http://localhost:5173,https://leadcrm.abaccotech.com
# MASTER_OTP=             # emergency OTP, works only on the OTP step
# RETENTION_MONTHS=4
# RETENTION_NOTICE_HOURS=48
# RETENTION_REPORT_EMAIL=info@abaccotech.com
# LOGIN_HISTORY_DAYS=7
# RELEASE_POPUP_HOURS=48
# DUPLICATE_WINDOW_MONTHS=2
# DOUBLE_TARGET_BONUS=5000
# CACHE_TTL_SECONDS=300
# DISABLE_SCHEDULER=false
# ---- attendance (optional, defaults shown) ----
# FULL_DAY_HOURS=9
# ATTENDANCE_MONTHS=2
# AUTO_CLOCK_OUT_IST=04:30
# ATTENDANCE_REPORT_EMAIL=info@abaccotech.com
# BIOMETRIC_DEVICE_KEY=
